# Vyn Memory — copy to `.env` and fill in random tokens before running `docker compose up -d`.
# Quick way to generate fresh random tokens:
#   python3 -c 'import secrets; [print(f"MEMORY_{r}_TOKEN={secrets.token_urlsafe(32)}") for r in ("OWNER","CLAUDE","CHATGPT","ANTIGRAVITY","HERMES")]'

# Port exposed on 127.0.0.1 (put HTTPS in front via Caddy, nginx, or Cloudflare Tunnel)
MEMORY_PORT=8770

# Public URL clients use for OAuth metadata, /apps instructions, and device login links
MEMORY_PUBLIC_URL=http://127.0.0.1:8770

# Required role tokens (use long random values; never commit `.env`)
MEMORY_OWNER_TOKEN=replace-with-random-owner-token
MEMORY_CLAUDE_TOKEN=replace-with-random-claude-token
MEMORY_CHATGPT_TOKEN=replace-with-random-chatgpt-token
MEMORY_ANTIGRAVITY_TOKEN=replace-with-random-antigravity-token
MEMORY_HERMES_TOKEN=replace-with-random-hermes-token

# Optional: custom scopes, aliases, and dashboard layout (mount settings.json in docker-compose.yml)
# MEMORY_SETTINGS=/app/settings.json

# Optional: set to 1 ONLY when behind Cloudflare Tunnel so rate limits use CF-Connecting-IP
# MEMORY_BEHIND_CLOUDFLARE=1

# Optional: comma-separated HTTPS hosts allowed as OAuth 2.1 redirect targets (loopback is always allowed)
# MEMORY_OAUTH_REDIRECT_HOSTS=claude.ai,claude.com,chatgpt.com,chat.openai.com

# Optional: Omni SSO sign-in (leave unset to sign in directly with MEMORY_OWNER_TOKEN)
# OMNI_PUBLIC_URL=https://omni.example.com
# OMNI_INTERNAL_URL=http://omni:8000
# OMNI_MEMORY_KEY=replace-with-omni-key
# MEMORY_ADMIN_EMAILS=you@example.com
